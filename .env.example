# ============================================================
# commerce-ai-assistant — Environment Variables (development)
# Copy to .env before running `docker compose up -d`
# Never commit real secrets.
# ============================================================

# --- Compose project ---
COMPOSE_PROJECT_NAME=commerce-ai

# --- PostgreSQL ---
POSTGRES_DB=commerce
POSTGRES_USER=commerce
POSTGRES_PASSWORD=commerce_dev_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://commerce:commerce_dev_password@postgres:5432/commerce?schema=public

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0

# --- RabbitMQ ---
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=commerce
RABBITMQ_PASSWORD=commerce_dev_password
RABBITMQ_URL=amqp://commerce:commerce_dev_password@rabbitmq:5672
RABBITMQ_INDEXING_QUEUE=commerce.indexing.product

# --- NestJS API ---
API_PORT=3000
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=2h

# --- FastAPI AI Service ---
AI_SERVICE_PORT=8000
AI_SERVICE_URL=http://ai-service:8000

# --- LLM Providers ---
# OpenRouter key is recommended for multi-provider support (OpenAI-compatible).
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL_CHAT=gpt-4o-mini
OPENAI_MODEL_STRONG=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_BASE_URL=

# --- Model routing / fallback ---
LLM_MODEL_FALLBACK_ENABLED=true

# --- Embeddings (local fallback) ---
EMBEDDINGS_LOCAL_MODEL=BAAI/bge-small-en-v1.5
EMBEDDINGS_USE_LOCAL=false
# Deterministic BOW hashing embeddings: offline dev/CI only (no OpenAI key needed).
EMBEDDINGS_USE_HASH=false

# --- Langfuse ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_ENABLED=false

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=commerce-ai
TRACING_ENABLED=false
# Base64 of "public:public:secret" (otel-collector -> langfuse auth), used by compose.
OTEL_LANGFUSE_AUTH=cHVibGljOnB1YmxpYzpzZWNyZXQ=

# --- Rate limiting ---
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=60

# --- Seed / bootstrap ---
SEED_DEMO_USER_EMAIL=demo@commerce.ai
SEED_DEMO_USER_PASSWORD=demo1234
