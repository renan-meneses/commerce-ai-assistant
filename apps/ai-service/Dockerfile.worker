# syntax=docker/dockerfile:1
FROM python:3.13-slim AS runtime

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY pyproject.toml ./
COPY app ./app
RUN pip install --no-cache-dir . \
    && python -c "import app.indexing.worker_main"

CMD ["python", "-m", "app.indexing.worker_main"]
